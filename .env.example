# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Stripe (Developers > API keys)
STRIPE_SECRET_KEY=sk_live_or_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_or_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_CONNECT_CLIENT_ID=ca_xxx

# Commission
COMMISSION_PERCENT=20
COMMISSION_CAP_CENTS=50000

# Resend (transactional email for watchlist alerts + claim invites)
RESEND_API_KEY=re_xxx
EMAIL_FROM="SaddleUp <notifications@yourdomain.com>"

# eBay import (developer.ebay.com > Application Keys > Production keyset)
# Leave blank to hide the "Import from eBay" box. EBAY_ENV=sandbox uses sandbox keys.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENV=production
# Any random 32-80 char string; must match the token entered in eBay > Alerts & Notifications
EBAY_VERIFICATION_TOKEN=

# AI listing reader (console.anthropic.com > API Keys). Blank = rule-based reader only.
ANTHROPIC_API_KEY=

# App
NEXT_PUBLIC_SITE_URL=https://saddleup.com
CRON_SECRET=generate_a_random_string
